# Firebase Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Sentry (optional) — leave blank to disable error reporting
EXPO_PUBLIC_SENTRY_DSN=

# Public legal-policy URLs. These links are shown on the sign-up screen.
# BEFORE RELEASE: replace the placeholders below with the HTTPS URLs of
# the Terms of Service and Privacy Policy pages hosted by your
# organization (e.g. on your NGO's website or a hosted document
# service). They MUST be:
#   - HTTPS (not http://)
#   - Fully-qualified (https://example.com/terms, not /terms)
#   - Owned by your organization (not a third-party repo or a
#     localhost / placeholder URL)
# If a URL is left blank or unreachable at runtime, the sign-up
# screen falls back to a "link unavailable" snackbar rather than
# silently opening the wrong page.
EXPO_PUBLIC_TERMS_URL=https://your-organization.example/terms
EXPO_PUBLIC_PRIVACY_URL=https://your-organization.example/privacy
